@{
    ViewData["Title"] = "Your CV";
}

<section class="page-head">
    <div>
        <span class="eyebrow plain">Step 1 of 3</span>
        <h1 class="h1">Your CV</h1>
        <p class="muted">The AI uses this to score every recruiter and to write your outreach. Paste it below or let AI extract it from a PDF.</p>
    </div>
</section>

<div class="cv-layout">
    <aside class="cv-aside">
        <div class="card">
            <div class="card-title"><div class="icon-tile"><i data-icon="upload"></i></div>Import from PDF</div>
            <div class="dropzone" id="pdfDropzone" role="button" tabindex="0">
                <input type="file" id="pdfFile" accept=".pdf,application/pdf" />
                <i data-icon="file" style="width:30px;height:30px;color:#a5b4fc"></i>
                <span class="dropzone-title" id="pdfFileName">Drop your CV (PDF)</span>
                <span class="dropzone-hint">or click to browse</span>
            </div>
            <button type="button" class="btn btn-primary btn-block" id="extractBtn" style="margin-top:14px" disabled>
                <i data-icon="sparkles"></i>Extract with AI
            </button>
            <div id="pdfProgress" style="margin-top:14px" hidden>
                <div class="progress"><div id="pdfProgressFill" class="progress-fill"></div></div>
                <div class="small dim" id="pdfStatus" style="margin-top:8px;text-align:center">Uploading…</div>
            </div>
        </div>

        <div class="card">
            <div class="card-title"><div class="icon-tile"><i data-icon="bulb"></i></div>Tips for better matches</div>
            <ul class="tip-list">
                <li><i data-icon="check"></i><span>List your stack explicitly — languages, frameworks, databases, cloud.</span></li>
                <li><i data-icon="check"></i><span>Include location and work authorisation (EU citizen, B2B, remote…).</span></li>
                <li><i data-icon="check"></i><span>Add measurable results and live project links.</span></li>
            </ul>
            <hr class="divider" />
            <p class="small dim" style="display:flex;gap:8px">
                <i data-icon="shield" style="width:16px;height:16px;flex-shrink:0;margin-top:3px"></i>
                Your CV is stored only in this browser (localStorage) and sent to the server just for analysis.
            </p>
        </div>
    </aside>

    <div class="card editor-card">
        <div class="editor-head">
            <div class="window-dots"><span></span><span></span><span></span></div>
            <span class="mono small dim">cv.txt</span>
            <span class="badge badge-violet" id="cvSource">Default CV</span>
            <div class="spacer"></div>
            <button type="button" class="btn btn-ghost btn-sm" id="resetBtn" title="Restore the default CV">
                <i data-icon="refresh"></i>Reset
            </button>
        </div>

        <textarea id="cvData" class="editor-textarea" spellcheck="false" placeholder="Paste your CV here…" aria-label="CV text"></textarea>

        <div class="editor-foot">
            <span class="small dim mono" id="charCounter">0 characters</span>
            <div class="spacer"></div>
            <a asp-action="Index" class="btn btn-ghost">Cancel</a>
            <button type="button" class="btn btn-primary" id="saveBtn">
                Save &amp; continue<i data-icon="arrowRight"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/match-form.js" asp-append-version="true"></script>
}
