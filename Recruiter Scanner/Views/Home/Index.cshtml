@model RecruiterUploadViewModel
@{
    ViewData["Title"] = "Recruiters";

    static bool HasLink(string? url) => !string.IsNullOrWhiteSpace(url) && url != "http://" && url != "https://";
    static string DisplayUrl(string url) => url.Replace("https://", "").Replace("http://", "").Replace("www.", "").TrimEnd('/');
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        <i data-icon="alert"></i>
        <div>@Model.ErrorMessage</div>
    </div>
}

<section class="page-head">
    <div>
        <h1 class="h1">Recruiters</h1>
        <p class="muted">Analyze the recruiters against the demo CV (Marko Keser), then continue to write emails.</p>
    </div>
    <div class="page-actions">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
            <input type="file" id="recruiterFile" name="csvFile" accept=".csv,.json" hidden />
            <button type="button" class="btn btn-ghost" id="uploadBtn"><i data-icon="upload"></i>Upload CSV</button>
        </form>
        <button type="button" id="analyzeBtn" class="btn btn-primary"><i data-icon="sparkles"></i>Analyze</button>
        <button type="button" id="nextBtn" class="btn" disabled>Continue<i data-icon="arrowRight"></i></button>
    </div>
</section>

<div id="progressPanel" class="card progress-panel" hidden>
    <div class="row">
        <strong id="progressText">Preparing…</strong>
        <span class="mono muted" id="progressPercent">0%</span>
    </div>
    <div class="progress"><div id="progressFill" class="progress-fill"></div></div>
</div>

<div class="card table-card">
    <div class="table-scroll">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Recruiter</th>
                    <th>Email</th>
                    <th>Location</th>
                    <th>AI score</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @for (var i = 0; i < Model.Recruiters.Count; i++)
                {
                    var r = Model.Recruiters[i];
                    <tr data-index="@i">
                        <td data-label="Company">
                            <div class="cell-flex">
                                <div class="avatar" data-avatar="@r.CompanyNameForEmails"></div>
                                <div style="min-width:0">
                                    <span class="cell-main truncate">@r.CompanyNameForEmails</span>
                                    @if (HasLink(r.Website))
                                    {
                                        <a href="@r.Website" target="_blank" rel="noopener" class="cell-sub truncate">@DisplayUrl(r.Website!)</a>
                                    }
                                </div>
                            </div>
                        </td>
                        <td data-label="Recruiter">
                            <div class="cell-main">@r.FirstName @r.LastName</div>
                            <div class="cell-sub truncate">@r.Title</div>
                        </td>
                        <td data-label="Email">
                            @if (!string.IsNullOrWhiteSpace(r.Email))
                            {
                                <a href="mailto:@r.Email" class="truncate small">@r.Email</a>
                            }
                            else
                            {
                                <span class="dim">—</span>
                            }
                        </td>
                        <td data-label="Location">@r.City</td>
                        <td data-label="AI score" class="score-cell">
                            <span class="score-pill score-pending">Not analyzed</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Match analysis modal -->
<div id="matchModal" class="overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="matchModalTitle">
    <div class="dialog">
        <div class="dialog-header">
            <div id="matchModalAvatar"></div>
            <div style="min-width:0">
                <h2 id="matchModalTitle">AI match analysis</h2>
                <div class="cell-sub" id="matchModalSubtitle"></div>
            </div>
            <button type="button" class="btn btn-ghost btn-icon dialog-close" data-close-modal aria-label="Close"><i data-icon="x"></i></button>
        </div>
        <div class="dialog-body" id="matchContent"></div>
    </div>
</div>

@section Scripts {
    <script id="recruitersData" type="application/json">@Html.Raw(Json.Serialize(Model.Recruiters))</script>
    <script id="demoCvData" type="application/json">@Html.Raw(Json.Serialize(Model.DemoCv))</script>
    <script src="~/js/home.js" asp-append-version="true"></script>
}
