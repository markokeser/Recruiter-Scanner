@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="card empty-state" style="max-width:640px;margin:40px auto">
    <div class="icon-tile" style="color:var(--danger)"><i data-icon="alert"></i></div>
    <h1 class="h2">Something went wrong</h1>
    <p class="muted">An error occurred while processing your request. Please try again in a moment.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small dim">Request ID: <code class="kbd">@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i data-icon="arrowLeft"></i>Back to home</a>
</div>
